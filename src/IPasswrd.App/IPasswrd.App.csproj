<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows-TFM ради UserNotificationListener (перехват СМС-кодов из «Связи с телефоном») -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ipasswrd_app.ico</ApplicationIcon>
    <AssemblyName>IPasswrd.App</AssemblyName>
    <RootNamespace>IPasswrd.App</RootNamespace>

    <!-- Издатель. ⚠ Пока сборка не подписана сертификатом, это только сведения о файле:
         Windows всё равно скажет «неизвестный издатель». Настоящую подпись даёт
         Microsoft Store (бесплатно) либо сертификат. -->
    <Version>1.0.29</Version>
    <Company>yoyoloxxx Dev</Company>
    <Authors>yoyoloxxx Dev</Authors>
    <Product>IPasswrd</Product>
    <AssemblyTitle>IPasswrd</AssemblyTitle>
    <Copyright>© yoyoloxxx Dev</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Windows DPAPI for quick unlock (session key at rest, tied to the Windows account) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <!-- Registry for "start with Windows" -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- Ужатие картинок перед тем, как положить их в сейф: сейф едет в облако целиком
         на каждое сохранение, поэтому скан с телефона надо уменьшить, а не хранить как есть. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IPasswrd.Core\IPasswrd.Core.csproj" />
  </ItemGroup>

  <!-- App/tray icons: bundled as Avalonia resources, loaded at runtime via avares://IPasswrd.App/Assets/... -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
