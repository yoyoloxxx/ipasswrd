<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9.0-ios (не net10): Hot Restart в VS 2022 работает только с net9 (в net10 сломан,
         dotnet/maui#33553; в VS 2026 Hot Restart удалён совсем). Android добавится сюда же
         вторым TFM, когда поставим Android SDK: net9.0-ios;net9.0-android -->
    <TargetFramework>net9.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>IPasswrd.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>IPasswrd</ApplicationTitle>
    <!-- совпадает с id нативного хоста браузера: com.yoyoloxxx.ipasswrd -->
    <ApplicationId>com.yoyoloxxx.ipasswrd</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>

    <!-- Argon2id (Konscious) — управляемый код: в Debug/Hot Restart работает интерпретатор,
         первая разблокировка может занять несколько секунд; в Release с AOT — быстро. -->
    <MtouchInterpreter Condition="'$(Configuration)'=='Debug'">-all</MtouchInterpreter>

    <!-- сейф сериализуется рефлексией System.Text.Json — защищаем от триммера в Release -->
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="IPasswrd.Core" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#090C10" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#090C10" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiXaml Update="Resources\Styles\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IPasswrd.Core\IPasswrd.Core.csproj" />
  </ItemGroup>

</Project>
