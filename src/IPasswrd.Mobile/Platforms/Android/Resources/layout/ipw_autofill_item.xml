<?xml version="1.0" encoding="utf-8"?>
<!-- Строка подсказки автозаполнения. Рисуется процессом заполняемого приложения,
     поэтому цвета задаём явно, а не через атрибуты темы. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/ipw_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="#FF101418"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/ipw_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#FF5A646E"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
