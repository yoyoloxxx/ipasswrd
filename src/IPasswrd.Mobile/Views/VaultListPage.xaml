<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:IPasswrd.Mobile.Views"
             x:Class="IPasswrd.Mobile.Views.VaultListPage"
             Title="Сейф">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="＋" Clicked="OnAdd" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">

        <SearchBar x:Name="Search" Grid.Row="0" Placeholder="Поиск" TextChanged="OnSearch" Margin="8,0" />

        <Button x:Name="SectionBtn" Grid.Row="1" Clicked="OnSectionMenu"
                FontSize="14" Padding="14,6" CornerRadius="14"
                HorizontalOptions="Start" Margin="12,2,12,8"
                BackgroundColor="{AppThemeBinding Dark={StaticResource IpSurface2}, Light={StaticResource IpSurface2L}}"
                TextColor="{AppThemeBinding Dark={StaticResource IpText}, Light={StaticResource IpTextL}}" />

        <CollectionView x:Name="List" Grid.Row="2" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:VaultRow">
                    <Grid Padding="{Binding Pad}">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{AppThemeBinding Dark={StaticResource IpAccentWash}, Light={StaticResource IpAccentWashL}}">
                                    <Label Text="{Binding Badge}" FontSize="16" FontAttributes="Bold"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Dark={StaticResource IpAccent}, Light={StaticResource IpAccentL}}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontSize="16" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" Style="{StaticResource Muted}" FontSize="13" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding Star}" FontSize="14" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Dark={StaticResource IpAccent}, Light={StaticResource IpAccentL}}" />
                                <Label Grid.Column="3" Text="›" FontSize="20" VerticalOptions="Center" Margin="0,0,2,2"
                                       TextColor="{AppThemeBinding Dark={StaticResource IpText3}, Light={StaticResource IpText3L}}" />
                            </Grid>
                        </Border>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40" Spacing="8" VerticalOptions="Center">
                    <Label Text="Пока пусто" HorizontalOptions="Center" Style="{StaticResource Muted}" />
                    <Label Text="Добавьте запись кнопкой «＋» или включите синхронизацию с Windows в настройках."
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" Style="{StaticResource Muted}" FontSize="13" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>

</ContentPage>
