<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IPasswrd.Mobile.Views.ItemEditPage">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Сохранить" Clicked="OnSave" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16,10,16,40" Spacing="10">

            <Border Style="{StaticResource Card}" Padding="14,4">
                <Entry x:Name="TitleBox" Placeholder="Название" />
            </Border>

            <!-- ======== аккаунт ======== -->
            <VerticalStackLayout x:Name="AccountForm" Spacing="10" IsVisible="False">
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <Entry x:Name="UrlBox" Placeholder="Сайт (например, ozon.ru)" Keyboard="Url" />
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <Entry x:Name="UserBox" Placeholder="Логин" />
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                        <Entry x:Name="PasswordEdit" Placeholder="Пароль" IsPassword="True" FontFamily="Menlo" />
                        <Button Grid.Column="1" Text="👁" FontSize="15" Padding="8,4" BackgroundColor="Transparent" Clicked="OnRevealPassword" />
                        <Button Grid.Column="2" Text="🎲" FontSize="15" Padding="8,4" BackgroundColor="Transparent" Clicked="OnGeneratePassword" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <Entry x:Name="TotpBox" Placeholder="Код проверки (секрет или otpauth://)" />
                        <Button Grid.Column="1" Text="Скан QR" FontSize="14" Padding="10,4" BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Dark={StaticResource IpAccent}, Light={StaticResource IpAccentL}}"
                                Clicked="OnScanTotp" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- ======== карта ======== -->
            <VerticalStackLayout x:Name="CardForm" Spacing="10" IsVisible="False">
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry x:Name="NumberBox" Placeholder="Номер карты" Keyboard="Numeric" FontFamily="Menlo" TextChanged="OnNumberChanged" />
                        <Label x:Name="BrandLabel" Grid.Column="1" VerticalOptions="Center" Style="{StaticResource Muted}" FontSize="13" />
                    </Grid>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Style="{StaticResource Card}" Padding="14,4">
                        <Entry x:Name="ExpiryBox" Placeholder="ММ/ГГ" Keyboard="Numeric" TextChanged="OnExpiryChanged" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,4">
                        <Entry x:Name="CvcBox" Placeholder="CVC/CVV" Keyboard="Numeric" IsPassword="True" MaxLength="4" />
                    </Border>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <Entry x:Name="HolderBox" Placeholder="Держатель (как на карте)" />
                </Border>
            </VerticalStackLayout>

            <!-- ======== документ ======== -->
            <VerticalStackLayout x:Name="DocumentForm" Spacing="10" IsVisible="False">
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <Entry x:Name="DocNumberBox" Placeholder="Номер" />
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <Entry x:Name="IssuedBox" Placeholder="Кем и когда выдан" />
                </Border>
            </VerticalStackLayout>

            <!-- ======== личные данные ======== -->
            <VerticalStackLayout x:Name="IdentityForm" Spacing="10" IsVisible="False">
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <Entry x:Name="LastNameBox" Placeholder="Фамилия" />
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <Entry x:Name="FirstNameBox" Placeholder="Имя" />
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <Entry x:Name="MiddleNameBox" Placeholder="Отчество" />
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <Entry x:Name="PhoneBox" Placeholder="Телефон" Keyboard="Telephone" />
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <Entry x:Name="EmailBox" Placeholder="Почта" Keyboard="Email" />
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Style="{StaticResource Card}" Padding="14,4">
                        <Entry x:Name="ZipBox" Placeholder="Индекс" Keyboard="Numeric" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,4">
                        <Entry x:Name="CountryBox" Placeholder="Страна" />
                    </Border>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <Entry x:Name="CityBox" Placeholder="Город" />
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <Entry x:Name="StreetBox" Placeholder="Улица, дом, квартира" />
                </Border>
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <Editor x:Name="NotesBox" Placeholder="Заметки" AutoSize="TextChanges" MinimumHeightRequest="80" />
            </Border>

            <!-- Вложения добавляются прямо здесь и уезжают в сейф вместе с записью:
                 фотографию паспорта человек делает тогда же, когда заводит документ, а не потом. -->
            <Border Style="{StaticResource Card}" Padding="14,10">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Вложения" FontSize="13" Style="{StaticResource Muted}" />
                    <VerticalStackLayout x:Name="AttachRows" Spacing="6" />
                    <Button x:Name="AttachAdd" FontSize="14" Padding="0,6" BackgroundColor="Transparent"
                            HorizontalOptions="Start"
                            TextColor="{AppThemeBinding Dark={StaticResource IpAccent}, Light={StaticResource IpAccentL}}"
                            Clicked="OnAddAttachment" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="ErrorLabel" IsVisible="False" FontSize="14"
                   TextColor="{AppThemeBinding Dark={StaticResource IpBad}, Light={StaticResource IpBadL}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
