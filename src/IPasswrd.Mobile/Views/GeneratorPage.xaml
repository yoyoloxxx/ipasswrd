<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IPasswrd.Mobile.Views.GeneratorPage"
             Title="Генератор">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16,14,16,30" Spacing="12">

                <Border Style="{StaticResource Card}" Padding="16,20">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="PasswordLabel" FontSize="22" FontFamily="Menlo" FontAttributes="Bold"
                               LineBreakMode="CharacterWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label x:Name="StrengthLabel" HorizontalOptions="Center" Style="{StaticResource Muted}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Скопировать" Style="{StaticResource Primary}" Clicked="OnCopy" />
                    <Button Grid.Column="1" Text="Обновить" Clicked="OnRegenerate" />
                </Grid>

                <Label Text="ДЛИНА" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Slider x:Name="LengthSlider" Minimum="8" Maximum="64" Value="20" ValueChanged="OnLengthChanged" />
                        <Label x:Name="LengthLabel" Grid.Column="1" Text="20" WidthRequest="34"
                               VerticalOptions="Center" HorizontalTextAlignment="End" FontFamily="Menlo" />
                    </Grid>
                </Border>

                <Label Text="СИМВОЛЫ" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}" Padding="14,2">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="Строчные (abc)" VerticalOptions="Center" />
                            <Switch x:Name="LowerSwitch" Grid.Column="1" IsToggled="True" Toggled="OnOptionToggled" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Dark={StaticResource IpHair}, Light={StaticResource IpHairL}}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="Прописные (ABC)" VerticalOptions="Center" />
                            <Switch x:Name="UpperSwitch" Grid.Column="1" IsToggled="True" Toggled="OnOptionToggled" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Dark={StaticResource IpHair}, Light={StaticResource IpHairL}}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="Цифры (123)" VerticalOptions="Center" />
                            <Switch x:Name="DigitsSwitch" Grid.Column="1" IsToggled="True" Toggled="OnOptionToggled" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Dark={StaticResource IpHair}, Light={StaticResource IpHairL}}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="Символы (!@#)" VerticalOptions="Center" />
                            <Switch x:Name="SymbolsSwitch" Grid.Column="1" IsToggled="True" Toggled="OnOptionToggled" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Dark={StaticResource IpHair}, Light={StaticResource IpHairL}}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <Label Text="Исключать похожие (l, I, O, 0…)" VerticalOptions="Center" />
                            <Switch x:Name="AmbiguousSwitch" Grid.Column="1" IsToggled="True" Toggled="OnOptionToggled" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border x:Name="Toast" IsVisible="False" InputTransparent="True"
                VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,28"
                StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16,9"
                BackgroundColor="{AppThemeBinding Dark={StaticResource IpSurface2}, Light={StaticResource IpTextL}}">
            <Label x:Name="ToastLabel" FontSize="14"
                   TextColor="{AppThemeBinding Dark={StaticResource IpText}, Light={StaticResource IpSurfaceL}}" />
        </Border>
    </Grid>

</ContentPage>
