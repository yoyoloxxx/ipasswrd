<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IPasswrd.Mobile.Views.SettingsPage"
             Title="Настройки">

    <Grid>
        <ScrollView>
        <VerticalStackLayout Padding="16,6,16,40" Spacing="10">

            <Label Text="ДОСТУП" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}" Padding="14,2">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                        <Label x:Name="BiometricLabel" Text="Быстрая разблокировка" VerticalOptions="Center" />
                        <Switch x:Name="BiometricSwitch" Grid.Column="1" Toggled="OnBiometricToggled" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Dark={StaticResource IpHair}, Light={StaticResource IpHairL}}" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                        <Label Text="Автоблокировка" VerticalOptions="Center" />
                        <Picker x:Name="AutolockPicker" Grid.Column="1" SelectedIndexChanged="OnAutolockChanged" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Label x:Name="AccessHint" Text="После простоя сейф закрывается; биометрия открывает его без мастер-пароля. Мастер-пароль переспрашивается раз в 30 дней."
                   Style="{StaticResource Muted}" FontSize="12" Margin="4,0" />

            <Label Text="БУФЕР ОБМЕНА" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}" Padding="14,2">
                <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                    <Label Text="Очищать после копирования" VerticalOptions="Center" />
                    <Picker x:Name="ClipboardPicker" Grid.Column="1" SelectedIndexChanged="OnClipboardChanged" />
                </Grid>
            </Border>
            <Label Text="Скопированный пароль или код автоматически стирается из буфера обмена через выбранное время."
                   Style="{StaticResource Muted}" FontSize="12" Margin="4,0" />

            <Label Text="СИНХРОНИЗАЦИЯ С WINDOWS" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}" Padding="14,10">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="SyncTitle" Text="Локальный сейф" FontSize="16" />
                    <Label x:Name="SyncSub" Text="без синхронизации" Style="{StaticResource Muted}" FontSize="13" />
                    <Button x:Name="SyncGoogleButton" Text="Войти через Google" Clicked="OnConnectGoogle" />
                    <Button x:Name="SyncConnectButton" Text="Выбрать файл сейфа…" BackgroundColor="Transparent" Clicked="OnConnectSync" />
                    <Button x:Name="SyncNowButton" Text="Синхронизировать сейчас" IsVisible="False" Clicked="OnSyncNow" />
                    <Button x:Name="SyncDisconnectButton" Text="Отключить" BackgroundColor="Transparent" IsVisible="False" Clicked="OnDisconnectSync" />
                </VerticalStackLayout>
            </Border>
            <Label x:Name="SyncHint"
                   Text="Вход через Google — тот же Google Диск, что на Windows (папка IPasswrd, файл vault.ipvault). Изменения объединяются поэлементно."
                   Style="{StaticResource Muted}" FontSize="12" Margin="4,0" />

            <Label Text="КОД ВОССТАНОВЛЕНИЯ" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}" Padding="14,10">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="RecoveryStatus" FontSize="15" />
                    <Button x:Name="RecoveryCreateButton" Text="Создать код восстановления" Clicked="OnCreateRecovery" />
                    <Button x:Name="RecoveryDeleteButton" Text="Удалить код" BackgroundColor="Transparent" IsVisible="False"
                            Clicked="OnDeleteRecovery"
                            TextColor="{AppThemeBinding Dark={StaticResource IpBad}, Light={StaticResource IpBadL}}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="Код восстановления открывает сейф, если забыт мастер-пароль. Единственная копия показывается один раз — запишите её. У сейфа появляется вторая дверь: кто знает код и имеет файл, откроет сейф."
                   Style="{StaticResource Muted}" FontSize="12" Margin="4,0" />

            <Label Text="СЕЙФ" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}" Padding="14,4">
                <VerticalStackLayout>
                    <Button Text="Импортировать из файла…" BackgroundColor="Transparent" Clicked="OnImport" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Dark={StaticResource IpHair}, Light={StaticResource IpHairL}}" />
                    <Button Text="Сменить мастер-пароль" BackgroundColor="Transparent" Clicked="OnChangePassword" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Dark={StaticResource IpHair}, Light={StaticResource IpHairL}}" />
                    <Button Text="Экспортировать копию сейфа…" BackgroundColor="Transparent" Clicked="OnExportCopy" />
                <BoxView HeightRequest="1" Color="{AppThemeBinding Dark={StaticResource IpHair}, Light={StaticResource IpHairL}}" />
                    <Button Text="Выгрузить CSV со всеми паролями…" BackgroundColor="Transparent" Clicked="OnExportCsv" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Dark={StaticResource IpHair}, Light={StaticResource IpHairL}}" />
                    <Button Text="Восстановить из резервной копии…" BackgroundColor="Transparent" Clicked="OnRestoreBackup" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Dark={StaticResource IpHair}, Light={StaticResource IpHairL}}" />
                    <Button Text="Заблокировать" BackgroundColor="Transparent" Clicked="OnLock" />
                </VerticalStackLayout>
            </Border>
            <Label Text="Импорт паролей из CSV (Chrome, Bitwarden, LastPass и др.) или из текстового экспорта Kaspersky. Дубликаты не создаются."
                   Style="{StaticResource Muted}" FontSize="12" Margin="4,0" />

            <Label Text="О ПРИЛОЖЕНИИ" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}" Padding="14,10">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="AboutTitle" Text="IPasswrd" FontSize="16" />
                    <Label x:Name="VersionLabel" Style="{StaticResource Muted}" FontSize="13" />
                    <Label Text="Тот же зашифрованный сейф, что и на Windows: Argon2id + AES-256-GCM. Файл сейфа не покидает ваши устройства и ваше облако."
                           Style="{StaticResource Muted}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
        </ScrollView>

        <Border x:Name="Toast" IsVisible="False" InputTransparent="True"
                VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,28"
                StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16,9"
                BackgroundColor="{AppThemeBinding Dark={StaticResource IpSurface2}, Light={StaticResource IpTextL}}">
            <Label x:Name="ToastLabel" FontSize="14"
                   TextColor="{AppThemeBinding Dark={StaticResource IpText}, Light={StaticResource IpSurfaceL}}" />
        </Border>
    </Grid>

</ContentPage>
