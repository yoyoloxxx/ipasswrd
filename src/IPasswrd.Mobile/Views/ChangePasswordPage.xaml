<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IPasswrd.Mobile.Views.ChangePasswordPage"
             Title="Мастер-пароль">

    <ScrollView>
        <VerticalStackLayout Padding="16,14" Spacing="10">

            <Border Style="{StaticResource Card}" Padding="14,4">
                <Entry x:Name="OldBox" Placeholder="Текущий мастер-пароль" IsPassword="True" />
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,4">
                <Entry x:Name="NewBox" Placeholder="Новый мастер-пароль" IsPassword="True" />
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,4">
                <Entry x:Name="ConfirmBox" Placeholder="Новый мастер-пароль ещё раз" IsPassword="True" />
            </Border>

            <Label x:Name="ErrorLabel" IsVisible="False" FontSize="14"
                   TextColor="{AppThemeBinding Dark={StaticResource IpBad}, Light={StaticResource IpBadL}}" />

            <Button x:Name="SaveButton" Text="Сменить" Style="{StaticResource Primary}" Clicked="OnSave" />
            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" HorizontalOptions="Center" />

            <Label Text="Записи не перешифровываются: меняется только обёртка ключа, поэтому смена мгновенно попадёт и на Windows после синхронизации."
                   Style="{StaticResource Muted}" FontSize="12" Margin="4,6" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
