<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9.0 добавлен для мобильного приложения (net9.0-ios, пока Hot Restart не дружит с net10);
         Windows-приложение и тесты по-прежнему берут net10.0. -->
    <TargetFrameworks>net10.0;net9.0</TargetFrameworks>
    <!-- CI iOS-сборка идёт на SDK 9, который не умеет net10: -p:IpwNet9Only=true -->
    <TargetFrameworks Condition="'$(IpwNet9Only)'=='true'">net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IPasswrd.Core</AssemblyName>
    <RootNamespace>IPasswrd.Core</RootNamespace>
    <Description>IPasswrd security core: Argon2id KDF + AES-256-GCM envelope-encrypted vault. Transport-agnostic.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Argon2id (pure-managed, cross-platform incl. iOS/Android). AES-256-GCM is built into .NET. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Official Public Suffix List (publicsuffix.org). Embedded; parsed by PublicSuffix.cs. -->
    <EmbeddedResource Include="public_suffix_list.dat" />
  </ItemGroup>

</Project>
