<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9 = mobile TFM; net10 = Windows/desktop. M16: run the same unlock-pull /
         autolock / Autofill-policy suite on both so SDK skew cannot hide a TFM-only break. -->
    <TargetFrameworks>net10.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\IPasswrd.Core\IPasswrd.Core.csproj" />
  </ItemGroup>

  <!-- Pure Windows helpers (no Avalonia) — compile here so Ubuntu CI can cover audit L7/L8. -->
  <ItemGroup>
    <Compile Include="..\..\windows\IPasswrd.App\SmsRelayInfoFile.cs" Link="Linked\SmsRelayInfoFile.cs" />
    <Compile Include="..\..\windows\IPasswrd.App\NativeHostLocator.cs" Link="Linked\NativeHostLocator.cs" />
  </ItemGroup>

  <!-- Pure AppUpdate integrity gates (no MAUI) — audit M2 hash / host pin on Linux CI. -->
  <ItemGroup>
    <Compile Include="..\..\mobile\IPasswrd.Mobile\Services\AppUpdateIntegrity.cs" Link="Linked\AppUpdateIntegrity.cs" />
  </ItemGroup>

</Project>
