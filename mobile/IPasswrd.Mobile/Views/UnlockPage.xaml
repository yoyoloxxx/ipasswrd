<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IPasswrd.Mobile.Views.UnlockPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Dark={StaticResource IpBgDeep}, Light={StaticResource IpBgDeepL}}">

    <ScrollView>
        <VerticalStackLayout Padding="28,0" Spacing="14" VerticalOptions="Center">

            <Label Text="IPasswrd"
                   FontSize="40" FontAttributes="Bold" HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Dark={StaticResource IpAccent}, Light={StaticResource IpAccentL}}" />
            <Label x:Name="Subtitle" Text="Сейф закрыт" HorizontalOptions="Center" Style="{StaticResource Muted}" Margin="0,0,0,18" />

            <Border Style="{StaticResource Card}" Padding="16,6">
                <Entry x:Name="PasswordBox" Placeholder="Мастер-пароль" IsPassword="True"
                       ReturnType="Go" Completed="OnPrimaryAction" />
            </Border>

            <Label x:Name="MeterLabel" IsVisible="False" FontSize="12" Margin="4,-6,4,0" />

            <Border x:Name="ConfirmCard" Style="{StaticResource Card}" Padding="16,6" IsVisible="False">
                <Entry x:Name="ConfirmBox" Placeholder="Мастер-пароль ещё раз" IsPassword="True"
                       ReturnType="Go" Completed="OnPrimaryAction" />
            </Border>

            <Label x:Name="ErrorLabel" IsVisible="False" FontSize="14"
                   TextColor="{AppThemeBinding Dark={StaticResource IpBad}, Light={StaticResource IpBadL}}" />

            <Button x:Name="PrimaryButton" Text="Открыть" Style="{StaticResource Primary}" Clicked="OnPrimaryAction" />

            <Button x:Name="BiometricButton" Text="Биометрия" IsVisible="False" Clicked="OnBiometric" />

            <Button x:Name="ForgotButton" Text="Забыли мастер-пароль?" IsVisible="False"
                    Clicked="OnForgotPassword" BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Dark={StaticResource IpAccent}, Light={StaticResource IpAccentL}}" />

            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" HorizontalOptions="Center" />
            <Label x:Name="BusyHint" Text="Проверяю мастер-пароль…" IsVisible="False"
                   HorizontalOptions="Center" Style="{StaticResource Muted}" />

            <Button x:Name="GoogleButton" Text="Забрать сейф с Google Диска" LineBreakMode="WordWrap"
                    IsVisible="False" Clicked="OnConnectGoogle" BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Dark={StaticResource IpAccent}, Light={StaticResource IpAccentL}}" />

            <Button x:Name="ConnectButton" Text="Подключить файл сейфа"
                    IsVisible="False" Clicked="OnConnectExisting" BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Dark={StaticResource IpAccent}, Light={StaticResource IpAccentL}}" />

            <Label x:Name="StorageHint" HorizontalOptions="Center" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
