<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9.0 (не net10): Hot Restart в VS 2022 работает только с net9 (в net10 сломан,
         dotnet/maui#33553; в VS 2026 Hot Restart удалён совсем).
         Два TFM сразу нельзя восстанавливать там, где стоит только одна нагрузка MAUI:
         на macOS-раннере есть maui-ios, на ubuntu-раннере — maui-android. Поэтому
         сборки в CI передают -p:IpwIosOnly=true / -p:IpwAndroidOnly=true. -->
    <TargetFrameworks>net9.0-ios;net9.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(IpwIosOnly)'=='true'">net9.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="'$(IpwAndroidOnly)'=='true'">net9.0-android</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>IPasswrd.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>IPasswrd</ApplicationTitle>
    <!-- совпадает с id нативного хоста браузера: com.yoyoloxxx.ipasswrd -->
    <ApplicationId>com.yoyoloxxx.ipasswrd</ApplicationId>
    <ApplicationDisplayVersion>1.0.42</ApplicationDisplayVersion>
    <ApplicationVersion>10042</ApplicationVersion>

    <!-- сейф сериализуется рефлексией System.Text.Json — защищаем от триммера в Release -->
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

    <!-- AndroidX pins in the Android ItemGroup below intentionally hold shared packages at the
         generation MAUI 9.0.120 (Navigation 2.8.9.1) was tested against; NU1605/NU1608 expected. -->
    <NoWarn>$(NoWarn);NU1605;NU1608</NoWarn>
  </PropertyGroup>

  <!-- ================= iOS ================= -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <!-- Argon2id (Konscious) — управляемый код: в Debug/Hot Restart работает интерпретатор,
         первая разблокировка может занять несколько секунд; в Release с AOT — быстро. -->
    <MtouchInterpreter Condition="'$(Configuration)'=='Debug'">-all</MtouchInterpreter>
  </PropertyGroup>

  <!-- ================= Android ================= -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- 26 = Android 8.0: минимум для системного автозаполнения (AutofillService) -->
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Полный AOT (RunAOTCompilation) ускорил бы Argon2id, но раздувает время сборки в CI
         в разы. По умолчанию для Release работает профильный AOT — этого достаточно:
         в отличие от iOS, на Android нет запрета JIT. -->
  </PropertyGroup>

  <!-- iOS: как было до Android-порта, ничего не трогаем -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <TrimmerRootAssembly Include="IPasswrd.Core" />
  </ItemGroup>

  <!-- ⚠ Android-овский ILLink требует у TrimmerRootAssembly метаданные RootMode,
       иначе MSB4096 на шаге триммера в Release. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <TrimmerRootAssembly Include="IPasswrd.Core" RootMode="All" />
    <!-- классы, которые создаёт сама система (AutofillService, Activity) — только по имени из манифеста -->
    <TrimmerRootAssembly Include="IPasswrd.Mobile" RootMode="All" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#090C10" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#090C10" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiXaml Update="Resources\Styles\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- Отпечаток/лицо — системный диалог BiometricPrompt -->
    <PackageReference Include="Xamarin.AndroidX.Biometric" Version="1.1.0.33" />
    <!-- Камера для QR: CameraX (превью + покадровый анализ) -->
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.4.2.3" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.4.2.3" />
    <PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.4.2.3" />
    <!-- Декодер QR — чистый управляемый код, без нативных зависимостей -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <!-- ⚠ CameraX тянет старый savedstate-ktx, а MAUI — savedstate 1.3, куда ktx уже
         вошёл целиком: androidx.savedstate.ViewKt оказывается в двух jar и D8 падает
         («Type … is defined multiple times»). Ktx-пакет выкидываем — он пустой дубль. -->
    <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.*" ExcludeAssets="all" />
  </ItemGroup>

  <!-- PIN (fixes startup crash): floating Biometric 1.1.0.* + Camera 1.4.* pulled the newest AndroidX
       (Fragment 1.8.9 / Lifecycle 2.11 / Activity 1.13). MAUI 9.0.120 ships Navigation 2.8.9.1 built for
       Fragment 1.8.6 / Lifecycle 2.8.7; the skew made NavHostFragment.get_NavController throw
       (JavaProxyThrowable) on the first navigation and the app died at startup. Hold the shared AndroidX
       packages at MAUI's tested generation (same versions MAUI's own .Ktx packages resolve to). -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.8.6.1" />
    <PackageReference Include="Xamarin.AndroidX.Activity" Version="1.10.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Collection" Version="1.5.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.8.7.3" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="2.8.7.3" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.8.7.3" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.8.7.3" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.8.7.3" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common" Version="2.8.7.3" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.8.7.3" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Jvm" Version="1.5.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common.Jvm" Version="2.8.7.3" />
    <!-- SavedState 1.5.x is KMP-split (type ISavedStateRegistryOwner moved to a .Android facade);
         the old-gen Activity/Fragment expect it in the base DLL, so hold SavedState pre-split. -->
    <PackageReference Include="Xamarin.AndroidX.SavedState" Version="1.2.1.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\IPasswrd.Core\IPasswrd.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <!-- Системное автозаполнение iOS: .appex собирается и кладётся в PlugIns автоматически.
         На Android автозаполнение живёт внутри этого же apk (Platforms/Android/AutoFill). -->
    <ProjectReference Include="..\IPasswrd.AutoFill\IPasswrd.AutoFill.csproj" />
  </ItemGroup>

</Project>
