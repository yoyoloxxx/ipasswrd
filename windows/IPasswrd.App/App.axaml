<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IPasswrd.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <!-- FluentTheme accent (native controls: toggles, slider, focus rings) — gold in both themes -->
      <Color x:Key="SystemAccentColor">#E1B85E</Color>
      <Color x:Key="SystemAccentColorDark1">#D0A84E</Color>
      <Color x:Key="SystemAccentColorDark2">#B8933F</Color>
      <Color x:Key="SystemAccentColorDark3">#9E7E32</Color>
      <Color x:Key="SystemAccentColorLight1">#EAC578</Color>
      <Color x:Key="SystemAccentColorLight2">#F2D28E</Color>
      <Color x:Key="SystemAccentColorLight3">#F8DEA6</Color>

      <ResourceDictionary.ThemeDictionaries>

        <!-- ============ Dark (default) ============ -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="IpBgDeep" Color="#05070B"/>
          <SolidColorBrush x:Key="IpBg" Color="#090C10"/>
          <SolidColorBrush x:Key="IpBgList" Color="#0E1115"/>
          <SolidColorBrush x:Key="IpSurface" Color="#14171D"/>
          <SolidColorBrush x:Key="IpSurface2" Color="#1B2025"/>
          <SolidColorBrush x:Key="IpText" Color="#E4E6E9"/>
          <SolidColorBrush x:Key="IpText2" Color="#9EA2A6"/>
          <SolidColorBrush x:Key="IpText3" Color="#686C72"/>
          <SolidColorBrush x:Key="IpAccent" Color="#E1B85E"/>
          <SolidColorBrush x:Key="IpAccentHi" Color="#F2C86C"/>
          <SolidColorBrush x:Key="IpOnAccent" Color="#231600"/>
          <SolidColorBrush x:Key="IpOk" Color="#6CC185"/>
          <SolidColorBrush x:Key="IpWarn" Color="#EA8E49"/>
          <SolidColorBrush x:Key="IpBad" Color="#E95048"/>
          <SolidColorBrush x:Key="IpHair" Color="#12FFFFFF"/>
          <SolidColorBrush x:Key="IpHairStrong" Color="#21FFFFFF"/>
          <SolidColorBrush x:Key="IpAccentWash" Color="#1AE1B85E"/>
          <SolidColorBrush x:Key="IpAccentWash2" Color="#2BE1B85E"/>
          <SolidColorBrush x:Key="IpBadWash" Color="#1FE95048"/>
          <SolidColorBrush x:Key="IpWarnWash" Color="#1FEA8E49"/>
        </ResourceDictionary>

        <!-- ============ Light ============ -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="IpBgDeep" Color="#EAE8E1"/>
          <SolidColorBrush x:Key="IpBg" Color="#F5F3EF"/>
          <SolidColorBrush x:Key="IpBgList" Color="#FAF9F6"/>
          <SolidColorBrush x:Key="IpSurface" Color="#FDFDFB"/>
          <SolidColorBrush x:Key="IpSurface2" Color="#F2F0EC"/>
          <SolidColorBrush x:Key="IpText" Color="#1E2228"/>
          <SolidColorBrush x:Key="IpText2" Color="#51555C"/>
          <SolidColorBrush x:Key="IpText3" Color="#808389"/>
          <SolidColorBrush x:Key="IpAccent" Color="#9F6C00"/>
          <SolidColorBrush x:Key="IpAccentHi" Color="#8E5A00"/>
          <SolidColorBrush x:Key="IpOnAccent" Color="#FDFAF4"/>
          <SolidColorBrush x:Key="IpOk" Color="#26894C"/>
          <SolidColorBrush x:Key="IpWarn" Color="#B75F0B"/>
          <SolidColorBrush x:Key="IpBad" Color="#C22826"/>
          <SolidColorBrush x:Key="IpHair" Color="#17000000"/>
          <SolidColorBrush x:Key="IpHairStrong" Color="#29000000"/>
          <SolidColorBrush x:Key="IpAccentWash" Color="#1A9F6C00"/>
          <SolidColorBrush x:Key="IpAccentWash2" Color="#2E9F6C00"/>
          <SolidColorBrush x:Key="IpBadWash" Color="#1FC22826"/>
          <SolidColorBrush x:Key="IpWarnWash" Color="#1FB75F0B"/>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="7" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource IpAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource IpOnAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IpAccentHi}" />
      <Setter Property="Foreground" Value="{DynamicResource IpOnAccent}" />
    </Style>

    <!-- Кнопка согласия в вопросах вроде «Удалить папку?»: выглядеть как обычное
         подтверждение она не должна — цвет здесь часть вопроса. -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource IpBadWash}" />
      <Setter Property="Foreground" Value="{DynamicResource IpBad}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IpBad}" />
      <Setter Property="Foreground" Value="{DynamicResource IpOnAccent}" />
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="{DynamicResource IpText2}" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IpSurface2}" />
    </Style>

    <Style Selector="Button.caption">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource IpText2}" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IpSurface2}" />
    </Style>
    <Style Selector="Button.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IpBad}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.side">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.side:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IpSurface}" />
    </Style>
    <Style Selector="Button.side.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IpAccentWash}" />
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="Margin" Value="6,1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IpSurface}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IpAccentWash}" />
    </Style>
    <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IpAccentWash}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IpAccentWash2}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="7" />
    </Style>
  </Application.Styles>
</Application>
